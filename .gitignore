# KhetiRental v2.0 — .gitignore
# Generated: 2026-06-22 | Preserved: .claude/hooks/git-guard.sh, .claude/settings.json, .claude/skills/*

# ── Secrets & credentials ───────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
*.gpg
credentials*
service-account*.json
!.env.example

# ── Local caches & write buffers ───────────────────────────────────────────
.claude/.cc-writes/
.claude/settings.local.json

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Go / compiled artifacts ────────────────────────────────────────────────
*.exe
*.out
bin/
build/
dist/

# ── IDE / editors ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Graphify build output (local code map; rewritten whole on every rebuild) ─
graphify-out/

# ── Scratch / agent work files ─────────────────────────────────────────────
# Keep .scratch/ tracked (it's the issue tracker).
# But ignore transient report files that get regenerated:
.scratch/*/flow/report-*.json

# ── Web app local data (dev photo uploads) ─────────────────────────────────
apps/web/.uploads/

# ── Build outputs ───────────────────────────────────────────────────────────
node_modules/
vendor/
target/

# ── Local git/agent tooling (kept on this machine, not part of the project) ─
.claude/skills/
.claude/verify-skills.py
.claude/hooks/commit-guard.sh
.claude/hooks/test_commit_guard.sh
.claude/launch.json
.scratch/khetirental-git-setup/
docs/commit-sequence.md
scripts/check-agent-tooling.sh
