{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booking.events.json",
  "title": "BookingEvent",
  "description": "Kafka topic: booking.events. Producer: booking-orchestrator. Consumers: matching-engine (lock release), escrow, telemetry-gateway.",
  "type": "object",
  "required": ["booking_id", "type", "state", "fencing_token", "ts"],
  "properties": {
    "booking_id": { "type": "string" },
    "type": {
      "enum": [
        "booking.reserve_inventory",
        "booking.compensate_inventory",
        "escrow.authorized",
        "escrow.payment_failed",
        "dispatch.notification_sent",
        "telemetry.active_window",
        "telemetry.post_return_audit",
        "escrow.settled"
      ]
    },
    "state": {
      "enum": [
        "PENDING", "INVENTORY_RESERVED", "ESCROW_AUTHORIZED", "DISPATCHED",
        "TELEMATICS_ACTIVE", "POST_RETURN_AUDIT", "SETTLED",
        "FAILED_PAYMENT_RELEASED", "FAILED_INVENTORY",
        "DISPUTE_OPEN", "SUSPENDED_BREAKDOWN", "NO_SHOW_PENDING"
      ]
    },
    "fencing_token": { "type": "integer", "minimum": 0 },
    "ts": { "type": "integer", "description": "unix millis" }
  }
}
