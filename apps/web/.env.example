# Copy to .env and adjust. With no optional keys set, every external service
# (Google sign-in, SMS OTP, payments, notifications) runs as a local mock.

# Postgres 16+ with PostGIS. Matches compose.yaml. `npm run db:setup` migrates and loads sample data.
DATABASE_URL=postgres://kheti:kheti@localhost:5432/kheti

# Session and OTP signing secret. Required in production. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# Optional: real Google sign-in. Leave empty to use the "Mock Google" sign-in (dev only). Setup steps are in the README.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: real email (password-reset links) through any SMTP server, e.g. Gmail with an app password:
#   smtps://you%40gmail.com:your-16-letter-app-password@smtp.gmail.com:465   (encode "@" in the user as %40)
# Empty: reset links are only logged (dev) and a deployment sends no email.
SMTP_URL=
# Optional: the From address. Defaults to the SMTP user. Gmail rewrites it to your own address.
MAIL_FROM=

# Optional: an SMS provider for phone OTP. None is built in, so leave both empty: a real deployment then hides
# the Mobile method and the OTP API answers 503 phone_login_unavailable. Dev keeps the on-screen code.
SMS_PROVIDER=
SMS_API_KEY=

# Optional, dev only: make the demo payment screen fail, to test the error path.
DEMO_PAYMENT_FAIL=false
# Optional: how long the demo payment "processes", in ms (default 1500).
DEMO_PAYMENT_DELAY_MS=1500


# Optional: password for the seeded sample accounts (default kheti-demo-2026).
SEED_PASSWORD=

# Never set in a real deployment: lets a production build (e2e tests) use Mock Google and log OTP codes.
ENABLE_MOCK_AUTH=

# The public address of the site, e.g. https://kheti.example. Used for canonical and language links and for the links in
# emails (never taken from the request). Required in production for password-reset emails. Defaults to http://localhost:3000 in dev.
SITE_URL=
