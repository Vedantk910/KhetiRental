{
  "name": "client-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@node-rs/argon2": "2.2.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "h3-js": "4.5.0",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "3.23.2",
    "intl-messageformat": "11.2.15",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
